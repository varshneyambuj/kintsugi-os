# Kintsugi build profiles.
#
# This file used to define release/nightly/bootstrap/minimum/test profiles
# inherited from Haiku. KintsugiOS only ships the kintsugi-* profiles below;
# the rest were removed during the build cleanup. The Haiku originals are
# preserved in build/jam.haiku-backup/ for reference.

# set HAIKU_BUILD_TYPE early
switch $(HAIKU_BUILD_PROFILE) {
	case "kintsugi-*" : {
		HAIKU_BUILD_TYPE = kintsugi ;
		EnableBuildFeatures minimum_image ;

		HAIKU_DEFINES += HAIKU_KINTSUGI_BUILD ;
		TARGET_DEFINES += HAIKU_KINTSUGI_BUILD ;
	}

	case "*" : {
		HAIKU_BUILD_TYPE = regular ;
		EnableBuildFeatures regular_image ;

		HAIKU_DEFINES += HAIKU_REGULAR_BUILD ;
		TARGET_DEFINES += HAIKU_REGULAR_BUILD ;
	}
}
Echo "Starting build of type $(HAIKU_BUILD_TYPE) ..." ;


rule DefineDefaultBuildProfiles
{
	# kintsugi profiles
	DefineBuildProfile kintsugi-raw : image : "kintsugi.image" ;
	DefineBuildProfile kintsugi-mmc : haiku-mmc-image : "kintsugi.mmc" ;
	DefineBuildProfile kintsugi-vmware : vmware-image : "kintsugi.vmdk" ;
	DefineBuildProfile kintsugi-cd : cd-image : "kintsugi.iso" ;
	DefineBuildProfile kintsugi-anyboot : anyboot-image
		: "kintsugi-anyboot.iso" ;

	switch $(HAIKU_BUILD_PROFILE) {
		case "kintsugi-*" : {
			Echo Building KintsugiOS ;
			HAIKU_ROOT_USER_NAME ?= user ;
			HAIKU_ROOT_USER_REAL_NAME ?= "Yourself" ;
			HAIKU_IMAGE_HOST_NAME ?= kintsugi ;
			HAIKU_IMAGE_SIZE ?= 400 ;

			AddHaikuImageSystemPackages
				openssl3
				;
		}
	}

	# If a build profile was specified on the command line, now is the time to
	# check whether it is unknown or one of the default profiles.
	if $(HAIKU_BUILD_PROFILE) && ! $(HAIKU_BUILD_PROFILE_DEFINED) {
		# define the obvious default profiles
		if $(HAIKU_BUILD_PROFILE) in cd-image install vmware-image {
			DefineBuildProfile $(HAIKU_BUILD_PROFILE) : $(HAIKU_BUILD_PROFILE) ;
		} else {
			Exit "Build profile" $(HAIKU_BUILD_PROFILE) "not defined." ;
		}
	}
}
