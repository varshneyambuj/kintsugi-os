# UserBuildConfig — customize a KintsugiOS build
#
# Create a file named "UserBuildConfig" in this directory (build/jam/) — jam
# reads it on every build. Anything legal in a Jamfile works there. Use
# UserBuildConfig.sample as a starting point.
#
# This is the place to override defaults like HAIKU_IMAGE_SIZE, add files to
# the image, enable debug builds, install onto a real device, etc., without
# editing the upstream build rules.
#
# The original Haiku version of this file (337 lines covering bootstrap
# images, ~10 build profiles, optional packages, third-party Jamfile
# integration, etc.) was largely irrelevant to KintsugiOS and was replaced.
# It's preserved at build/jam.haiku-backup/UserBuildConfig.ReadMe for
# reference if you ever need a feature it documented.

# ─────────────────────────────────────────────────────────────────────────
# Common overrides
# ─────────────────────────────────────────────────────────────────────────

# Image size in MB. Default for kintsugi-* profiles is 400.
#HAIKU_IMAGE_SIZE = 600 ;

# Install Kintsugi to a directory instead of an image.
#HAIKU_INSTALL_DIR = /Kintsugi ;

# Write directly to a device (CAREFUL — overwrites the device).
#HAIKU_IMAGE_DIR  = /dev ;
#HAIKU_IMAGE_NAME = sdc ;
#HAIKU_DONT_CLEAR_IMAGE = 1 ;

# Hostname baked into the image.
#HAIKU_IMAGE_HOST_NAME = kintsugi-edge-01 ;

# Root user account.
#HAIKU_ROOT_USER_NAME = ambuj ;
#HAIKU_ROOT_USER_REAL_NAME = "Ambuj Varshney" ;

# ─────────────────────────────────────────────────────────────────────────
# Per-directory debug builds
# ─────────────────────────────────────────────────────────────────────────

# Build src/system/boot/loader/ with debug symbols and -O0.
#SetConfigVar DEBUG : HAIKU_TOP src system boot loader : 1 : global ;

# ─────────────────────────────────────────────────────────────────────────
# Adding files to the image
# ─────────────────────────────────────────────────────────────────────────

# Drop arbitrary files into the image filesystem.
#AddFilesToHaikuImage home config settings
#	: $(HAIKU_TOP)/data/settings/first_boot/Locale\ settings ;

# Symlink with a custom name.
#AddSymlinkToHaikuImage home config settings : <keymap>US-International
#	: Key_map ;

# Recursive copy.
#CopyDirectoryToHaikuImage home Desktop
#	: $(HAIKU_TOP)/data/artwork : : -x .git ;

# ─────────────────────────────────────────────────────────────────────────
# Build invocation reminders
# ─────────────────────────────────────────────────────────────────────────
#
#   jam @kintsugi-anyboot                     # bootable iso (most common)
#   jam @kintsugi-raw                         # raw disk image
#   jam @kintsugi-anyboot update libbe.so     # rebuild + reinstall just libbe
#   jam @kintsugi-anyboot mount               # mount the iso under bfs_shell
#   ./wipe.sh && jam @kintsugi-anyboot        # force full clean rebuild
