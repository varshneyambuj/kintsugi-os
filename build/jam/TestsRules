# KintsugiOS test rules.
#
# Haiku's CppUnit-based UnitTest infrastructure (UnitTestLib, UnitTest,
# UnitTestResource, TestObjects, BuildPlatformTest, ...) was tied to the
# libbe_test build target. That target was removed during the Kintsugi
# build cleanup, so those rules went with it. Originals preserved in
# build/jam.haiku-backup/TestsRules.
#
# Only SimpleTest survives — it's a thin wrapper around Application that
# src/bin/media_client uses to build a debug helper binary.


rule SimpleTest
{
	# SimpleTest <target> : <sources> : [ <libraries> ] : [ <resources> ] ;

	# if TEST_DEBUG is defined, we turn on debugging
	if $(TEST_DEBUG) {
		DEBUG on $(1) [ FGristFiles $(2:S=$(SUFOBJ)) ] ?= 1 ;
	}

	Application $(1) : $(2) : $(3) : $(4) ;
}
